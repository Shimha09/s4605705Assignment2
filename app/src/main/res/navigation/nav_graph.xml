<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.s4605705assignment2.ui.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />

    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.s4605705assignment2.ui.DashboardFragment"
        android:label="Dashboard">

        <argument
            android:name="keypass"
            app:argType="string" />

        <action
            android:id="@+id/action_dashboardFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />

    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.s4605705assignment2.ui.DetailsFragment"
        android:label="Details">

        <argument
            android:name="name"
            app:argType="string" />

        <argument
            android:name="architect"
            app:argType="string" />

        <argument
            android:name="location"
            app:argType="string" />

        <argument
            android:name="yearCompleted"
            app:argType="integer" />

        <argument
            android:name="style"
            app:argType="string" />

        <argument
            android:name="height"
            app:argType="integer" />

        <argument
            android:name="description"
            app:argType="string" />

    </fragment>

</navigation>